{
  "name": "school-lunch-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd web-app && npm install && npm run build",
    "build:server": "npx prisma generate && cd sdk/wasp && npm run build && cd ../../server && npm run bundle",
    "build:client": "cd web-app && npm install && npm run build",
    "start": "npx prisma db push --accept-data-loss && cd server && npm start",
    "start:server": "npx prisma db push --accept-data-loss && cd server && npm start",
    "test": "vitest run"
  },
  "workspaces": [
    "server",
    "web-app",
    "sdk/wasp"
  ],
  "dependencies": {
    "@prisma/client": "5.19.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.428.0",
    "qrcode.react": "^4.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.0.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.10",
    "cookie-parser": "~1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "esbuild": "^0.25.0",
    "express": "~5.1.0",
    "helmet": "^6.0.0",
    "lucia": "^3.0.1",
    "@lucia-auth/adapter-prisma": "^4.0.0",
    "morgan": "~1.10.0",
    "prisma": "5.19.1",
    "superjson": "^2.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp.sh/spec": "file:sdk/wasp",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "rollup": "^4.9.6",
    "rollup-plugin-esbuild": "^6.1.1",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "@prisma/client@5.19.1": true,
    "@prisma/engines@5.19.1": true,
    "esbuild@0.25.0": true,
    "prisma@5.19.1": true
  }
}
