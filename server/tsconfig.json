{
  "compilerOptions": {
    "strict": false,
    "allowJs": true,
    "rootDir": ".",
    "sourceMap": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "target": "es2022",
    "lib": ["es2023"],
    "types": ["node"]
  },
  "include": [
    "src"
  ]
}
